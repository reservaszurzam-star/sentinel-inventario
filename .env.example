# =====================================================================
# LogixZazu — Environment Configuration Template
# =====================================================================
# Copia este archivo como `.env` en la raíz del proyecto y completa con
# las credenciales correspondientes a tu proyecto de Supabase.
# =====================================================================

# URL pública de tu instancia de Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Llave anónima pública de Supabase (Project Settings -> API -> anon public key)
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_ANON_KEY_HERE

# URL base para invocación directa de Supabase Edge Functions (opcional, fallback automático)
VITE_SUPABASE_FUNCTIONS_URL=https://YOUR_PROJECT_ID.supabase.co/functions/v1
